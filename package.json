{
  "name": "@danhachuel/thunderbolt",
  "version": "0.9.11",
  "description": "Thunderbolt — interface local para operação de canais faceless e motor MoneyPrinterTurbo",
  "license": "MIT",
  "main": "scripts/cli.mjs",
  "type": "module",
  "bin": {
    "thunderbolt": "scripts/cli.mjs"
  },
  "files": [
    "app/main.py",
    "app/influencers_ui.py",
    "app/social_networks_ui.py",
    "app/modules/**/*.py",
    "app/modules/niche_finder/kaggle_kernel/*.json",
    "hermes_ui/*.py",
    "integrations/*.py",
    "integrations/data/*.json",
    "scripts/*.mjs",
    "scripts/*.py",
    "seed/prompt_masters/**/*.md",
    "seed/blueprints/**/*.json",
    "seed/blueprints/**/*.md",
    "seed/ffmpeg/**/*.zip.part-*",
    "seed/skills/*.md",
    "seed/skills/*.py",
    "seed/test_upload_videos/*.mp4",
    "seed/references/*.md",
    "seed/references/*.sql",
    "README.md",
    "MANUAL-INSTALACAO.md",
    "THIRD-PARTY-NOTICES.md",
    "requirements.txt",
    "sitecustomize.py",
    "package.json",
    ".streamlit/config.toml"
  ],
  "scripts": {
    "postinstall": "node scripts/npx-cache-compat.mjs",
    "start": "node scripts/cli.mjs",
    "check": "node scripts/cli.mjs --check",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
